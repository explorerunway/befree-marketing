---
// Site.astro — shared shell for every marketing page.
// Head (fonts, meta, OG) + fixed paper-grain overlay + Nav + Footer.
// Values are verbatim from the design handoff specs (designs/*.dc.html).
import '../styles/tokens.css';
import '@phosphor-icons/web/bold';
import '@phosphor-icons/web/fill';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  active: 'home' | 'mac' | 'pricing' | 'android' | 'none';
}
const { title, description, active } = Astro.props;
// vercel.json sets cleanUrls + trailingSlash:false, so /mac answers 200 and
// /mac/ 308-redirects. Astro's pathname carries the trailing slash, which
// would make every subpage declare a canonical that is itself a redirect —
// strip it (but keep the bare "/" for the home page).
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site);
// Share card: 1200x630, fully opaque, carries the one message. The old
// og:image was the 316x318 transparent mascot, which every platform either
// shrank to a thumbnail or cropped and upscaled.
const ogImage = new URL('/og-card.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF6EC" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BeFree" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BeFree — tell it once, it won't let it slip" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="BeFree — tell it once, it won't let it slip" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Geist:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Vercel Web Analytics reads this GLOBAL rather than a prop: the Astro
      // component's Props type omits `beforeSend` and picks up
      // window.webAnalyticsBeforeSend instead, which the generic docs don't
      // say. Must be `is:inline` so it runs during parse — the <Analytics />
      // script is a bundled module and therefore deferred, so the global is
      // always set before it reads it.
      //
      // What it does: drops every query string except the campaign `ref`, so a
      // future campaign URL can never carry an email, token or address into
      // analytics. `ref` is kept deliberately — it is the one param the funnel
      // needs, and it is a campaign label, not a person.
      window.webAnalyticsBeforeSend = function (event) {
        try {
          var u = new URL(event.url);
          var ref = u.searchParams.get('ref');
          u.search = ref ? '?ref=' + encodeURIComponent(ref.slice(0, 64)) : '';
          return Object.assign({}, event, { url: u.toString() });
        } catch (e) {
          return event;
        }
      };
    </script>
    <Analytics />
  </head>
  <body>
    <div class="page">
      <div class="grain" aria-hidden="true"></div>
      <div class="content">
        <Nav active={active} />
        <slot />
        <Footer />
      </div>
    </div>
    <script is:inline>
      // Campaign attribution pass-through. A video/creator link lands here as
      // heybefree.app/adhd?ref=TT-SPRING; the signup happens one hop later on
      // app.heybefree.app, a DIFFERENT origin, so the code has to ride the
      // link across. The web app captures it at first load and stamps it on
      // the profile after sign-in (webapp/src/lib/attribution.ts).
      //
      // Deliberately `ref` and never `code` — `code` is Supabase's PKCE
      // auth-code parameter, and colliding with it would break sign-in.
      // Only web-app links get the param: an App Store URL would just carry a
      // stray query string, and Apple campaign attribution is a different
      // mechanism (pt/ct) that has to be minted in App Store Connect.
      (function () {
        try {
          var ref = new URLSearchParams(window.location.search).get('ref');
          if (!ref) return;
          ref = ref.trim().toUpperCase().slice(0, 32);
          if (!/^[A-Z0-9_-]{1,32}$/.test(ref)) return;
          // Two kinds of link get the param: the web-app door (where the code
          // is actually consumed) and same-origin internal links (so the code
          // survives /adhd → /pricing → Get BeFree instead of dying on the
          // first navigation). Store links, mailto:, and the Google/Play
          // tester links are all left exactly as authored.
          var here = window.location.origin;
          document.querySelectorAll('a[href]').forEach(function (a) {
            try {
              var u = new URL(a.href, here);
              var isWebApp = u.hostname === 'app.heybefree.app';
              var isInternal = u.origin === here;
              if (!isWebApp && !isInternal) return;
              if (u.protocol !== 'http:' && u.protocol !== 'https:') return;
              if (!u.searchParams.has('ref')) u.searchParams.set('ref', ref);
              a.href = u.toString();
            } catch (e) {
              /* leave the link exactly as authored */
            }
          });
        } catch (e) {
          /* attribution is best-effort; never break a link over it */
        }
      })();

      // Smart "Get BeFree" (owner, 2026-08-21): every a[data-get-befree]
      // routes to the visitor's own platform door. The markup default href is
      // the web app, so no-JS and unknown platforms still land somewhere real.
      //   iPhone/iPad → App Store record (universal purchase)
      //   Android     → /android tester flow (no Play production listing yet —
      //                 a store link would 404 for non-testers)
      //   Mac         → the same record's Mac page
      //   else        → app.heybefree.app (the markup default, untouched)
      (function () {
        var ua = navigator.userAgent;
        // iPadOS Safari reports "Macintosh"; touch points tell it apart.
        var iPad = /iPad/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        var href = null;
        if (/iPhone|iPod/.test(ua) || iPad) href = 'https://apps.apple.com/app/id6763826891';
        else if (/Android/.test(ua)) href = '/android#become-tester';
        else if (/Macintosh/.test(ua)) href = 'https://apps.apple.com/app/id6763826891?platform=mac';
        if (!href) return;
        document.querySelectorAll('a[data-get-befree]').forEach(function (a) {
          a.setAttribute('href', href);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  @keyframes bfBreathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
  }
  @keyframes bfPulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(2.3);
      opacity: 0;
    }
  }
  @media (max-width: 620px) {
    .bf-hide-sm {
      display: none !important;
    }
    .bf-split {
      grid-template-columns: 1fr !important;
    }
  }
  /* Respect reduced-motion: stop the infinite mascot/pulse loops entirely. */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<style>
  .page {
    position: relative;
    overflow-x: hidden;
  }
  .grain {
    /* absolute (scrolls with the page), NOT fixed. A fixed full-viewport
       mix-blend-mode layer forces the browser to re-blend the whole screen on
       every scroll frame — the main source of scroll jank. Letting it scroll
       with the content lets the compositor cache the blended layer. Visually
       identical for a fine noise texture. */
    position: absolute;
    inset: 0;
    background-image: url('/assets/paper-grain.png');
    background-size: 256px 256px;
    mix-blend-mode: multiply;
    opacity: 0.4;
    pointer-events: none;
    z-index: 0;
  }
  .content {
    position: relative;
    z-index: 1;
  }
</style>
