---
// Home — spec: designs/BeFree.dc.html.
import Site from '../layouts/Site.astro';
import BrainDumpDemo from '../components/BrainDumpDemo.astro';
import AppWindow from '../components/AppWindow.astro';
import StoreBadge from '../components/StoreBadge.astro';
import DownloadCTA from '../components/DownloadCTA.astro';

const features = [
  {
    icon: 'check-square',
    tool: 'var(--tool-task)',
    tint: 12,
    title: "Tasks that don't nag",
    body: "To-dos land with the right priority, quietly waiting until you're ready. No red badges screaming for attention.",
  },
  {
    icon: 'bell',
    tool: 'var(--tool-reminder)',
    tint: 12,
    title: 'Reminders, on time',
    body: 'Say "remind me to call mum tonight" and BeFree nudges you at the right moment — recurring ones included. Quiet hours mean it never buzzes you at midnight.',
  },
  {
    icon: 'calendar-dots',
    tool: 'var(--tool-event)',
    tint: 12,
    title: 'Events from a sentence',
    body: '"Lunch with Sam Friday at 1" becomes a real calendar event. BeFree resolves the day and time for you.',
  },
  {
    icon: 'list-checks',
    tool: 'var(--tool-grocery)',
    tint: 14,
    title: 'Lists that fill themselves',
    body: '"We\'re out of coffee and oat milk" drops both onto your groceries. Named lists, no tapping through menus.',
  },
  {
    icon: 'note',
    tool: 'var(--tool-note)',
    tint: 12,
    title: 'Notes, kept whole',
    body: "Half-formed thoughts and ideas stay intact — captured as notes, not forced into a checkbox they don't fit.",
  },
];

// Capabilities that already ship but were invisible on this page — every claim
// here is checked against the app: any-language parsing in ai-dump + 5 shipped
// UI locales (lib/i18n/locales), hybrid keyword+semantic search
// (services/search.ts), and JSON + iCal export (services/exports.ts). The
// Apple Calendar/Reminders read + opt-in write-back claims moved to the
// dedicated "lands" section above. Google Calendar API sync is deliberately
// ABSENT — it stays behind GOOGLE_CALENDAR_ENABLED=false until OAuth
// verification lands (the EventKit route in the lands section is how Google
// calendars already show up on iPhone).
const connects = [
  {
    icon: 'translate',
    tool: 'var(--accent)',
    tint: 14,
    title: 'Talk in any language',
    body: 'Speak whichever language you actually think in — BeFree parses it. The app itself speaks English, German, Spanish, French, and Japanese.',
  },
  {
    icon: 'magnifying-glass',
    tool: 'var(--tool-note)',
    tint: 12,
    title: 'Find the half-remembered thing',
    body: 'Search goes by meaning, not spelling. Ask for “that dentist thing” and the appointment you never properly named comes back.',
  },
  {
    icon: 'eye',
    tool: 'var(--tool-reminder)',
    tint: 12,
    title: 'It shows you what it knows',
    body: 'BeFree picks up a little about your life so sorting fits it. Ask “what do you know about me” and it lists every fact in your own words — delete any of them, any time.',
  },
  {
    icon: 'export',
    tool: 'var(--brass)',
    tint: 16,
    title: 'Your data can leave',
    body: 'Export your tasks, events, notes and lists to JSON, and your events to iCal, whenever you like. No lock-in, no hostage-taking — and deleting it all is just as easy.',
  },
];

// Every capture surface below is shipped and verified in the current builds:
// the Siri overlay intent (BeFreeBrainDumpIntent, openAppWhenRun=false — no
// app launch), Lock Screen capture tiles + the interactive Next-up tile
// (LockWidgets.swift; tasks complete in place, events display-only), the
// interactive home-screen Today widget, the Mac ⌘⇧Space capture bar, and the
// browser app. Android deliberately links to /android — it is early-access
// recruitment, not a store link.
const places = [
  {
    icon: 'waveform',
    tool: 'var(--accent)',
    tint: 12,
    title: '“Hey Siri, talk to BeFree”',
    body: "Say it hands-free. Siri asks what's on your mind, BeFree files it and confirms out loud — the app never has to open.",
  },
  {
    icon: 'lock-simple',
    tool: 'var(--tool-reminder)',
    tint: 12,
    title: 'From your Lock Screen',
    body: 'Mic and quick-type tiles sit under the clock — and the next task due can be checked off right there.',
  },
  {
    icon: 'squares-four',
    tool: 'var(--tool-task)',
    tint: 12,
    title: 'Widgets that do the work',
    body: 'Today at a glance on your Home Screen, with tasks you can mark done without launching anything.',
  },
  {
    icon: 'command',
    tool: 'var(--brass)',
    tint: 16,
    title: 'Anywhere on your Mac',
    body: "⌘⇧Space floats a capture bar over whatever you're doing. Say the thing, get back to work.",
  },
  {
    icon: 'globe',
    tool: 'var(--tool-event)',
    tint: 12,
    title: 'In any browser',
    body: 'Locked-down work laptop? The full app runs at app.heybefree.app — nothing to install.',
  },
  {
    icon: 'android-logo',
    tool: 'var(--tool-grocery)',
    tint: 14,
    title: 'Android, in early access',
    body: 'The Android build is taking founding testers — a year of Pro free, and a direct line to us.',
    href: '/android',
    linkLabel: 'Join early access',
  },
];

const windowCards = [
  { title: 'Design review', meta: '2:00 PM', icon: 'calendar-dots', tool: 'var(--tool-event)', checkable: false },
  { title: 'Call mum', meta: 'Tonight', icon: 'bell', tool: 'var(--tool-reminder)' },
  { title: 'Finish Q3 report', meta: 'Today · 5 PM', icon: 'check', tool: 'var(--tool-task)', priority: 'high' as const },
  { title: 'Coffee, oat milk', meta: 'Groceries', icon: 'basket', tool: 'var(--tool-grocery)' },
];

---

<Site
  title="BeFree — the brain dump app. Tell it once, it won't let it slip."
  description="Say it once — BeFree turns messy thoughts into tasks, reminders, events, lists and notes, and brings each one back on time. Free on iPhone, Mac and the web."
  active="home"
>
  <!-- Structured data. Deliberately NO aggregateRating/review: the listing has
       two ratings, and Google's software-app rich result requires ratings it
       would be dishonest to synthesise. This block states the offers and the
       platforms machine-readably; that is all it is for. -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "BeFree - Brain Dump",
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "iOS, macOS, Web",
      "url": "https://heybefree.app",
      "description": "Say it once — BeFree turns messy thoughts into tasks, reminders, events, lists and notes, and brings each one back on time.",
      "downloadUrl": "https://apps.apple.com/app/id6763826891",
      "offers": [
        {
          "@type": "Offer",
          "name": "Free",
          "price": "0",
          "priceCurrency": "USD"
        },
        {
          "@type": "Offer",
          "name": "Pro (annual)",
          "price": "24.99",
          "priceCurrency": "USD"
        },
        {
          "@type": "Offer",
          "name": "Pro (monthly)",
          "price": "3.49",
          "priceCurrency": "USD"
        }
      ]
    }
  </script>

  <!-- ══════════ HERO ══════════ -->
  <!-- One message, one CTA (owner, 2026-08-21): nothing else stands between
       the visitor and understanding. Platforms live in the nav; the demo two
       scrolls down is the proof. -->
  <section class="hero">
    <div class="mascot">
      <img src="/assets/cutemic.png" alt="BeFree mascot" />
    </div>
    <h1>Tell BeFree once.<br /><span class="voice">It won't let it slip.</span></h1>
    <p>
      Say the messy thing — BeFree turns it into tasks, reminders, events, lists and notes, and
      brings each one back at the right moment.
    </p>
    <div class="hero-cta">
      <a href="https://app.heybefree.app" class="hero-start" data-get-befree>
        Get BeFree <i class="ph-bold ph-arrow-right"></i>
      </a>
    </div>
    <div class="hero-free">Free · no card</div>
  </section>

  <!-- ══════════ LIVE DEMO ══════════ -->
  <section id="try" class="demo-section">
    <div class="demo-title">
      Try it now — say the messy thing. <span class="live-badge">live</span>
    </div>
    <div class="demo-stage">
      <BrainDumpDemo />
    </div>
    <div class="trust-row">
      <span>Free forever</span>
      <span class="sep"></span>
      <span>Nothing saved</span>
      <span class="sep"></span>
      <span>Never trains on your words</span>
    </div>
  </section>

  <!-- ══════════ HOW IT WORKS ══════════ -->
  <section class="how">
    <div class="section-head">
      <div class="eyebrow">How it works</div>
      <h2>Three seconds of talking.<br />A whole day, sorted.</h2>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-medal" style="background: color-mix(in srgb, var(--tool-capture) 12%, transparent);">
          <i class="ph-bold ph-microphone" style="color: var(--tool-capture);"></i>
        </div>
        <div class="step-num">01</div>
        <h3>Speak your mind</h3>
        <p>Open BeFree and just talk. The dentist, the coffee you're out of, that idea — all in one breath.</p>
      </div>
      <div class="step">
        <div class="step-medal" style="background: color-mix(in srgb, var(--accent) 12%, transparent);">
          <i class="ph-fill ph-sparkle" style="color: var(--accent);"></i>
        </div>
        <div class="step-num">02</div>
        <h3>It sorts itself</h3>
        <p>BeFree reads the mess and files each piece where it belongs — the right list, the right day, the right nudge.</p>
      </div>
      <div class="step">
        <div class="step-medal" style="background: color-mix(in srgb, var(--tool-grocery) 14%, transparent);">
          <i class="ph-bold ph-check-circle" style="color: var(--tool-grocery);"></i>
        </div>
        <div class="step-num">03</div>
        <h3>Walk out lighter</h3>
        <p>Your day's laid out and nothing's rattling around your head. That's the whole point.</p>
      </div>
    </div>
  </section>

  <!-- ══════════ IT LANDS WHERE YOU LOOK ══════════ -->
  <section class="lands">
    <div class="section-head">
      <div class="eyebrow">Not another inbox</div>
      <h2>It ends up where you<br />already look.</h2>
      <p class="section-sub">
        BeFree isn't a second system to keep checking. Flip on two-way sync and what you say lands
        in Apple Reminders and Apple Calendar — the right day, the right time, beside everything
        else in your life.
      </p>
    </div>
    <div class="lands-stage">
      <div class="lands-quote">
        <i class="ph-fill ph-quotes"></i>
        <span>“Grab Dad's prescription tomorrow at nine — oh, and lunch with Priya on Friday at one.”</span>
      </div>
      <div class="lands-arrow"><i class="ph-bold ph-arrow-down"></i></div>
      <div class="lands-rows">
        <div class="lands-row">
          <div class="lr-medal reminder"><i class="ph-bold ph-bell"></i></div>
          <div class="lr-text">
            <div class="lr-title">Grab Dad's prescription</div>
            <div class="lr-meta">Tomorrow · 9:00 AM</div>
          </div>
          <div class="lr-dest">→ Apple Reminders</div>
        </div>
        <div class="lands-row">
          <div class="lr-medal event"><i class="ph-bold ph-calendar-dots"></i></div>
          <div class="lr-text">
            <div class="lr-title">Lunch with Priya</div>
            <div class="lr-meta">Friday · 1:00 PM</div>
          </div>
          <div class="lr-dest">→ Apple Calendar</div>
        </div>
      </div>
    </div>
    <div class="lands-checks">
      <span class="lands-check"><i class="ph-bold ph-check"></i> Reads your iPhone's calendars — Google accounts included</span>
      <span class="lands-check"><i class="ph-bold ph-check"></i> Off until you switch it on — a switch per app, in Connections</span>
      <span class="lands-check"><i class="ph-bold ph-check"></i> Everything still syncs across iPhone, Mac &amp; web</span>
    </div>
  </section>

  <!-- ══════════ FEATURES ══════════ -->
  <section id="features" class="features">
    <div class="section-head">
      <div class="eyebrow">One dump, five kinds of order</div>
      <h2>Everything your head is holding —<br />each in its right place.</h2>
    </div>
    <div class="grid">
      {
        features.map((f) => (
          <div class="feature">
            <div
              class="feature-medal"
              style={`background: color-mix(in srgb, ${f.tool} ${f.tint}%, transparent);`}
            >
              <i class={`ph-bold ph-${f.icon}`} style={`color: ${f.tool};`} />
            </div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))
      }
      <div class="feature dark">
        <div class="grain-overlay" aria-hidden="true"></div>
        <div class="dark-inner">
          <div class="feature-medal" style="background: color-mix(in srgb, var(--accent) 30%, transparent);">
            <i class="ph-fill ph-sparkle" style="color: #E6C7ED;"></i>
          </div>
          <h3>AI that speaks human</h3>
          <p>
            The magic underneath: BeFree understands how you actually talk — run-ons, "oh and,"
            relative dates — and files it all correctly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ CAPTURE FROM ANYWHERE ══════════ -->
  <section class="anywhere">
    <div class="section-head">
      <div class="eyebrow">Capture from anywhere</div>
      <h2>The thought never waits<br />for the app.</h2>
      <p class="section-sub">
        Wherever the thought lands — locked phone, deep in a doc, someone else's laptop — BeFree is
        one tap or one sentence away.
      </p>
    </div>
    <div class="grid">
      {
        places.map((p) => (
          <div class="place">
            <div
              class="place-medal"
              style={`background: color-mix(in srgb, ${p.tool} ${p.tint}%, transparent);`}
            >
              <i class={`ph-bold ph-${p.icon}`} style={`color: ${p.tool};`} />
            </div>
            <div class="place-body">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              {p.href && (
                <a href={p.href} class="place-link">
                  {p.linkLabel} <i class="ph-bold ph-arrow-right" />
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ══════════ WHAT IT CONNECTS TO ══════════ -->
  <section id="connects" class="features">
    <div class="section-head">
      <div class="eyebrow">Not a walled garden</div>
      <h2>It fits the life<br />you already have.</h2>
    </div>
    <div class="grid">
      {
        connects.map((f) => (
          <div class="feature">
            <div
              class="feature-medal"
              style={`background: color-mix(in srgb, ${f.tool} ${f.tint}%, transparent);`}
            >
              <i class={`ph-bold ph-${f.icon}`} style={`color: ${f.tool};`} />
            </div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ══════════ MAC IN CONTEXT ══════════ -->
  <section class="mac-context">
    <div class="section-head">
      <div class="eyebrow">New — BeFree for Mac</div>
      <h2>Right where you already work.</h2>
      <p class="section-sub">
        A thought hits mid-email. Hit one hotkey, say it, and get back to work. That's BeFree for
        Mac — on the Mac App Store now, with menu-bar capture and instant iPhone sync built in.
      </p>
    </div>
    <div class="window-wrap">
      <AppWindow cards={windowCards} subtitle="Four things on the day." />
    </div>
    <div class="pills">
      <div class="pill"><i class="ph-bold ph-command" style="color: var(--accent);"></i> Global hotkey capture</div>
      <div class="pill"><i class="ph-bold ph-list" style="color: var(--brass);"></i> Menu-bar quick capture</div>
      <div class="pill"><i class="ph-bold ph-arrows-clockwise" style="color: var(--tool-event);"></i> Instant iPhone sync</div>
    </div>
    <div class="mac-actions">
      <StoreBadge store="mac" />
    </div>
    <div class="explore">
      <a href="/mac">Explore BeFree for Mac <i class="ph-bold ph-arrow-right"></i></a>
    </div>
  </section>

  <!-- ══════════ VOICE MOMENT ══════════ -->
  <section class="voice-moment">
    <i class="ph-fill ph-quotes"></i>
    <p>Put it all down. Walk out lighter.</p>
  </section>

  <!-- ══════════ PRICING TEASER ══════════ -->
  <section class="teaser">
    <div class="panel">
      <div class="copy">
        <div class="eyebrow">Pricing</div>
        <h2>Start free. Go Pro when life gets loud.</h2>
        <p>
          Everything's included free — capture, AI sorting, sync, widgets, Siri. Pro adds a bigger
          AI allowance, pooled over the whole year so a loud month borrows from the quiet ones —
          US$3.49 a month, or US$24.99 a year.
        </p>
      </div>
      <div class="actions">
        <a href="https://app.heybefree.app" class="primary" data-get-befree>Get BeFree</a>
        <a href="/pricing" class="secondary">Compare plans →</a>
      </div>
    </div>
  </section>

  <!-- ══════════ DOWNLOAD CTA ══════════ -->
  <DownloadCTA
    title="Tell it once."
    sub="Free on iPhone, Mac, and the web. Your first brain dump is thirty seconds away."
    meta="Free · iPhone, Mac &amp; browser"
  >
    <a href="https://app.heybefree.app" class="web-cta primary-web">
      <i class="ph-bold ph-globe"></i> Start free in your browser
    </a>
    <StoreBadge store="ios" />
    <StoreBadge store="mac" />
    <a href="/android" class="web-cta">
      <i class="ph-bold ph-android-logo"></i> Android early access
    </a>
  </DownloadCTA>
</Site>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--brass-deep);
    margin-bottom: 16px;
  }

  /* hero */
  .hero {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(34px, 6vh, 74px) clamp(18px, 4vw, 40px) clamp(20px, 3vh, 34px);
    text-align: center;
  }
  .mascot {
    width: 104px;
    height: 104px;
    margin: 0 auto clamp(16px, 2.5vh, 24px);
    animation: bfBreathe 4200ms cubic-bezier(0.65, 0, 0.35, 1) infinite;
    filter: drop-shadow(0 16px 22px rgba(31, 26, 20, 0.18));
    /* promote to its own layer so the infinite scale doesn't re-raster the
       drop-shadow every frame */
    will-change: transform;
  }
  .mascot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(38px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -2px;
    color: var(--text);
    margin: 0;
    text-wrap: balance;
  }
  .hero .voice {
    font-style: italic;
    font-weight: 600;
    color: var(--accent);
  }
  .hero p {
    font-family: var(--font-body);
    font-size: clamp(18px, 2.4vw, 22px);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: clamp(16px, 2.5vh, 24px) auto 0;
    max-width: 600px;
    text-wrap: pretty;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: clamp(22px, 3.2vh, 32px);
  }
  .hero-start {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    padding: 15px 28px;
    border-radius: var(--radius-input);
    box-shadow: var(--elev-2);
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }
  .hero-start:hover {
    transform: translateY(-2px);
    box-shadow: var(--elev-3);
  }
  .hero-start i {
    font-size: 18px;
    transition: transform 0.15s;
  }
  .hero-start:hover i {
    transform: translateX(3px);
  }
  .hero-free {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  /* demo */
  .demo-section {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px) clamp(16px, 3vh, 28px);
  }
  .demo-title {
    text-align: center;
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(19px, 2.6vw, 25px);
    color: var(--text);
  }
  .live-badge {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    vertical-align: middle;
    background: var(--accent-subtle);
    padding: 4px 9px;
    border-radius: var(--radius-badge);
  }
  .demo-stage {
    background: var(--accent-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sheet);
    padding: clamp(14px, 2.5vw, 24px);
    box-shadow: var(--elev-3);
  }
  .trust-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-muted);
  }
  .sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  /* section heads */
  .section-head {
    text-align: center;
    margin-bottom: clamp(30px, 5vh, 54px);
  }
  .section-head .eyebrow {
    margin-bottom: 12px;
  }
  .section-head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 4.6vw, 46px);
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--text);
    margin: 0;
    text-wrap: balance;
  }
  .section-sub {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 14px auto 0;
    max-width: 560px;
  }

  /* how it works */
  .how {
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(50px, 8vh, 100px) clamp(18px, 4vw, 40px) clamp(30px, 4vh, 50px);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 20px;
  }
  .step {
    text-align: center;
    padding: 8px;
  }
  .step-medal {
    width: 66px;
    height: 66px;
    margin: 0 auto 18px;
