---
// Android — a WORKING founding-tester enrollment flow, not a mailing-list
// pitch (owner, 2026-08-21). The Play Alpha track's tester source is the
// public Google Group (approved + live since 2026-07-12), so enrollment is
// genuinely self-serve: Google's own signed-in session authenticates each
// step, which is why every step is one tap and none can be done FOR the
// user by this site. Links verified live 2026-08-21:
//   group page 200 (public, "Join group" one-tap) · opt-in URL exists ·
//   the Play listing 404s for NON-testers — which is why the flow must run
//   in this exact order and step 3 warns about Google's registration lag.
// The tracked /l/android slug stays for SOCIAL posts; this page links the
// group directly so a future slug repoint can't loop the flow back here.
import Site from '../layouts/Site.astro';

const GROUP = 'https://groups.google.com/g/befree-android-testers';
const OPT_IN = 'https://play.google.com/apps/testing/app.befree';
const PLAY = 'https://play.google.com/store/apps/details?id=app.befree';

const perks = [
  { icon: 'ph-bold ph-sparkle', tone: 'plum', title: 'The real app, today', body: 'The tester build is the full BeFree — capture, AI sorting, widgets, the lot.' },
  { icon: 'ph-bold ph-star', tone: 'brass', title: '1 year of Pro, free', body: 'Founding testers get a full year on us — no card.' },
  { icon: 'ph-bold ph-chat-teardrop-dots', tone: 'olive', title: 'A direct line to the makers', body: 'Your feedback lands with us and shapes each build.' },
  { icon: 'ph-bold ph-seal-check', tone: 'plum', title: 'In before launch', body: 'You’re on the track before BeFree is public on Play — and your install is what gets it there.' },
];
---

<Site
  title="BeFree for Android — the brain dump app, in early access"
  description="Install BeFree for Android today through Google Play early access. Three taps: join the tester group, turn on testing, install. Founding testers get a free year of Pro."
  active="android"
>
  <!-- ══════════ HERO ══════════ -->
  <section class="hero">
    <div class="eyebrow">Android · Early access</div>
    <h1>On your phone<br />in three taps.</h1>
    <p>
      BeFree for Android is real and installable today — it ships through Google Play’s
      early-access program while we clear Play’s launch requirements. Join as a founding tester:
      a year of Pro on us, and your fingerprints on every release.
    </p>
    <div class="cta-row">
      <a href="#become-tester" class="btn-solid">Become a tester</a>
      <span class="cta-meta">Three taps · Free · No forms — your Google account is the sign-up</span>
    </div>
  </section>

  <!-- ══════════ PERKS ══════════ -->
  <section class="perks">
    <h2>What founding testers get</h2>
    <div class="grid">
      {
        perks.map((p) => (
          <div class="perk">
            <div class:list={['medallion', p.tone]}><i class={p.icon} /></div>
            <div class="perk-title">{p.title}</div>
            <div class="perk-body">{p.body}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ══════════ BECOME A TESTER — the live flow ══════════ -->
  <section class="how" id="become-tester">
    <h2>Become a tester, right here.</h2>
    <p class="how-sub">
      Google runs the tester program, so your Google account is the whole sign-up — each step is
      one tap if you’re signed in. Use the same account your phone’s Play Store uses.
    </p>

    <div class="device-note" id="at-device" hidden>
      <i class="ph-bold ph-device-mobile" aria-hidden="true"></i>
      <span id="at-device-text"></span>
      <button type="button" id="at-copy" class="copy-btn" hidden>Copy link</button>
    </div>

    <ol class="flow" id="at-flow">
      <li class="fstep" id="at-s1">
        <div class="fnum" aria-hidden="true"><span class="n">1</span><i class="ph-bold ph-check"></i></div>
        <div class="fbody">
          <div class="ftitle">Join the tester group</div>
          <div class="ftext">
            This puts you on the official tester list — Google recognises you the moment you join.
            One tap on “Join group”, then come back here.
          </div>
          <div class="factions">
            <a class="btn-solid faction" data-step="1" href={GROUP} target="_blank" rel="noopener">
              Join the group <i class="ph-bold ph-arrow-square-out"></i>
            </a>
            <button class="fdone" data-step="1" type="button">I’ve joined</button>
          </div>
        </div>
      </li>

      <li class="fstep locked" id="at-s2">
        <div class="fnum" aria-hidden="true"><span class="n">2</span><i class="ph-bold ph-check"></i></div>
        <div class="fbody">
          <div class="ftitle">Turn on testing for your account</div>
          <div class="ftext">
            Google shows one button — “Become a tester”. Tap it and you’re enrolled.
          </div>
          <div class="factions">
            <a class="btn-solid faction" data-step="2" href={OPT_IN} target="_blank" rel="noopener">
              Become a tester <i class="ph-bold ph-arrow-square-out"></i>
            </a>
            <button class="fdone" data-step="2" type="button">Done</button>
          </div>
        </div>
      </li>

      <li class="fstep locked" id="at-s3">
        <div class="fnum" aria-hidden="true"><span class="n">3</span><i class="ph-bold ph-check"></i></div>
        <div class="fbody">
          <div class="ftitle">Install BeFree from Google Play</div>
          <div class="ftext">
            The store listing is visible to testers only. If Play says the app isn’t found, give it
            a few minutes — Google can take a moment to register new testers — and check you’re
            signed into the same account.
          </div>
          <div class="factions">
            <a class="btn-solid faction" data-step="3" href={PLAY} target="_blank" rel="noopener">
              Get it on Google Play <i class="ph-bold ph-arrow-square-out"></i>
            </a>
            <button class="fdone" data-step="3" type="button">Installed</button>
          </div>
        </div>
      </li>
    </ol>

    <div class="flow-foot">
      <span class="flow-status" id="at-status" aria-live="polite"></span>
      <button type="button" id="at-reset" class="flow-reset" hidden>Start over</button>
    </div>

    <p class="fineprint">
      Free · the tester build is the full app · you can leave the program any time. Once you’re in,
      say hello in the group — that’s the direct line.
    </p>
  </section>

  <!-- ══════════ VOICE MOMENT ══════════ -->
  <section class="voice-moment">
    <p>You talk. We ship. The Android build gets your fingerprints on every release.</p>
  </section>

  <!-- ══════════ FINAL CTA ══════════ -->
  <section class="final">
    <div class="panel">
      <div class="grain" aria-hidden="true"></div>
      <div class="inner">
        <div class="mascot"><img src="/assets/cutemic.png" alt="" /></div>
        <h2>Grab a founding seat.</h2>
        <p>A free year of Pro, a direct line to us, and a build you helped shape.</p>
        <a href="#become-tester" class="btn-light">Become a tester</a>
        <div class="meta">Founding seats · Android only</div>
      </div>
    </div>
  </section>

  <script is:inline>
    // The tester flow is sequential BY GOOGLE'S DESIGN (group → opt-in →
    // install; the store listing 404s for non-testers), so state is a single
    // "steps completed" integer. Clicking a step's action optimistically
    // marks it done — the user comes back from Google's tab with the next
    // step lit. The done-buttons exist for people who already did a step
    // elsewhere, and double as Undo on a completed step.
    (function () {
      var KEY = 'bf-android-tester-step';
      var TOTAL = 3;
      var state = 0;
      try { state = Math.min(TOTAL, Math.max(0, parseInt(localStorage.getItem(KEY) || '0', 10) || 0)); } catch (e) {}

      function save() { try { localStorage.setItem(KEY, String(state)); } catch (e) {} }

      function render() {
        for (var i = 1; i <= TOTAL; i++) {
          var li = document.getElementById('at-s' + i);
          if (!li) continue;
          var done = state >= i;
          var active = state === i - 1;
          li.classList.toggle('done', done);
          li.classList.toggle('locked', !done && !active);
          li.querySelectorAll('a.faction').forEach(function (a) {
            a.setAttribute('aria-disabled', !done && !active ? 'true' : 'false');
            a.tabIndex = !done && !active ? -1 : 0;
          });
          var btn = li.querySelector('button.fdone');
          if (btn) {
            btn.textContent = done ? 'Undo' : btn.getAttribute('data-label') || btn.textContent;
            if (!btn.getAttribute('data-label')) btn.setAttribute('data-label', btn.textContent);
          }
        }
        var status = document.getElementById('at-status');
        var reset = document.getElementById('at-reset');
        if (status) {
          status.textContent =
            state === 0 ? 'Three taps between you and BeFree.' :
            state === 1 ? 'One down — now turn on testing.' :
            state === 2 ? 'Almost — Play is registering you. Install away.' :
            'You’re in. Welcome aboard, founding tester.';
          status.classList.toggle('celebrate', state === TOTAL);
        }
        if (reset) reset.hidden = state === 0;
      }

      document.querySelectorAll('#at-flow a.faction').forEach(function (a) {
        a.addEventListener('click', function (ev) {
          var n = parseInt(a.getAttribute('data-step'), 10);
          if (a.getAttribute('aria-disabled') === 'true') { ev.preventDefault(); return; }
          if (state < n) { state = n; save(); render(); }
        });
      });
      document.querySelectorAll('#at-flow button.fdone').forEach(function (b) {
        b.addEventListener('click', function () {
          var n = parseInt(b.getAttribute('data-step'), 10);
          state = state >= n ? n - 1 : n; // toggle: complete, or undo back to before this step
          save(); render();
        });
      });
      var resetBtn = document.getElementById('at-reset');
      if (resetBtn) resetBtn.addEventListener('click', function () { state = 0; save(); render(); });

      // Device awareness: the flow works anywhere, but installing needs the
      // Android phone — so off-Android we lead with getting the link there.
      var note = document.getElementById('at-device');
      var text = document.getElementById('at-device-text');
      var copy = document.getElementById('at-copy');
      if (note && text) {
        var onAndroid = /Android/.test(navigator.userAgent);
        text.textContent = onAndroid
          ? 'You’re on your Android — perfect. Do the three taps right here.'
          : 'You’re not on your Android right now. The steps work here with your Google account, but the install lands on the phone — easiest is to open this page there.';
        note.hidden = false;
        if (!onAndroid && copy) {
          copy.hidden = false;
          copy.addEventListener('click', function () {
            var url = 'https://heybefree.app/android';
            var ok = function () { copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy link'; }, 2000); };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(ok, function () { window.prompt('Copy this link:', url); });
            } else {
              window.prompt('Copy this link:', url);
            }
          });
        }
      }

      render();
    })();
  </script>
</Site>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--brass-deep);
    margin-bottom: 16px;
  }

  /* hero */
  .hero {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(40px, 7vh, 84px) clamp(18px, 4vw, 40px) clamp(20px, 3vh, 30px);
    text-align: center;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1;
    letter-spacing: -1.6px;
    color: var(--text);
    margin: 0;
    text-wrap: balance;
  }
  .hero p {
    font-family: var(--font-body);
    font-size: clamp(18px, 2.4vw, 22px);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: clamp(16px, 2.5vh, 22px) auto 0;
    max-width: 560px;
    text-wrap: pretty;
  }
  .cta-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: clamp(24px, 3.5vh, 34px);
  }
  .btn-solid {
    text-decoration: none;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    padding: 14px 30px;
    border-radius: var(--radius-input);
    box-shadow: var(--elev-1);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .btn-solid:hover {
    transform: translateY(-1px);
    box-shadow: var(--elev-2);
  }
  .cta-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* perks */
  .perks {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(24px, 4vh, 48px) clamp(18px, 4vw, 40px);
  }
  .perks h2,
  .how h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(26px, 3.8vw, 38px);
    letter-spacing: -0.6px;
    color: var(--text);
    margin: 0 0 24px;
    text-align: center;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }
  .perk {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    box-shadow: var(--elev-1);
    padding: 24px;
  }
  .medallion {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-medallion);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .medallion i {
    font-size: 20px;
  }
  .medallion.plum {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .medallion.brass {
    background: color-mix(in srgb, var(--brass) 20%, transparent);
    color: var(--brass-deep);
  }
  .medallion.olive {
    background: color-mix(in srgb, var(--tool-grocery) 16%, transparent);
    color: var(--tool-grocery);
  }
  .perk-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--text);
    margin-bottom: 5px;
  }
  .perk-body {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* become-a-tester flow */
  .how {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(24px, 4vh, 48px) clamp(18px, 4vw, 40px);
    /* the hero + nav CTAs deep-link here — land with air above the heading */
    scroll-margin-top: 80px;
  }
  .how-sub {
    text-align: center;
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 540px;
    margin: -8px auto 22px;
  }
  .device-note {
    display: flex;
    align-items: center;
    gap: 11px;
    background: var(--accent-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 13px 16px;
    margin-bottom: 16px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-secondary);
  }
  .device-note i {
    color: var(--accent);
    font-size: 18px;
    flex: none;
  }
  .copy-btn {
    flex: none;
    margin-left: auto;
    cursor: pointer;
    background: var(--bg-card);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-chip);
    padding: 7px 13px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    color: var(--text);
  }
  .copy-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fstep {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    box-shadow: var(--elev-1);
    padding: 20px 22px;
    transition: opacity 0.2s;
  }
  .fstep.locked {
    opacity: 0.45;
  }
  .fstep.locked .factions {
    pointer-events: none;
  }
  .fnum {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-medallion);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fnum i {
    display: none;
    font-size: 16px;
  }
  .fstep.done .fnum {
    background: var(--tool-grocery);
  }
  .fstep.done .fnum .n {
    display: none;
  }
  .fstep.done .fnum i {
    display: block;
  }
  .fbody {
    flex: 1;
    min-width: 0;
  }
  .ftitle {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    color: var(--text);
    margin-bottom: 3px;
  }
  .ftext {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .factions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 13px;
  }
  .faction {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    padding: 11px 20px;
  }
  .faction i {
    font-size: 14px;
  }
  .fdone {
    cursor: pointer;
    background: transparent;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-chip);
    padding: 9px 15px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13.5px;
    color: var(--text-secondary);
  }
  .fdone:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .flow-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .flow-status {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 16.5px;
    color: var(--text-secondary);
  }
  .flow-status.celebrate {
    color: var(--accent);
  }
  .flow-reset {
    cursor: pointer;
    background: none;
    border: none;
    padding: 4px;
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--text-muted);
    text-decoration: underline;
  }
  .flow-reset:hover {
    color: var(--accent);
  }
  .fineprint {
    text-align: center;
    margin-top: 20px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-muted);
  }
  .fineprint a {
    color: var(--text-secondary);
  }
  .fineprint a:hover {
    color: var(--accent);
  }

  /* voice moment */
  .voice-moment {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(24px, 4vh, 44px) clamp(18px, 4vw, 40px);
    text-align: center;
  }
  .voice-moment p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(22px, 3.2vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.3px;
    color: var(--text);
    margin: 0;
    text-wrap: balance;
  }

  /* final cta */
  .final {
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(20px, 3vh, 40px) clamp(18px, 4vw, 40px) clamp(44px, 7vh, 84px);
  }
  .panel {
    background: var(--bg-inverse);
    border-radius: var(--radius-sheet);
    padding: clamp(36px, 6vw, 72px) clamp(24px, 4vw, 48px);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .panel .grain {
    position: absolute;
    inset: 0;
    background-image: url('/assets/paper-grain.png');
    background-size: 256px 256px;
    mix-blend-mode: overlay;
    opacity: 0.18;
    pointer-events: none;
  }
  .panel .inner {
    position: relative;
  }
  .mascot {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    animation: bfBreathe 4200ms cubic-bezier(0.65, 0, 0.35, 1) infinite;
    will-change: transform;
  }
  .mascot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .panel h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.02;
    letter-spacing: -1.2px;
    color: #f2ead6;
    margin: 0;
    text-wrap: balance;
  }
  .panel p {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 19px);
    color: #c4b89d;
    margin: 14px auto 26px;
    max-width: 440px;
  }
  .btn-light {
    display: inline-block;
    text-decoration: none;
    background: #f2ead6;
    color: #2a2320;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    padding: 13px 28px;
    border-radius: var(--radius-input);
    transition: transform 0.15s;
  }
  .btn-light:hover {
    transform: translateY(-1px);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #7e725f;
    margin-top: 18px;
  }
</style>
