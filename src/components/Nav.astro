---
// Sticky blurred nav — spec: designs/BeFree*.dc.html "NAV" section.
// The links are a PLATFORM PICKER (owner, 2026-08-21): iOS · Mac · Android ·
// Web, so a visitor reaches their surface in one tap. iOS goes straight to
// the App Store listing and Web straight into the app — no interstitial page;
// Mac and Android keep their on-site pages (Mac sells the desktop powers,
// Android recruits early-access testers). Active page gets weight 600 +
// accent (and ph-fill for its glyph).
interface Props {
  active: 'home' | 'mac' | 'pricing' | 'android' | 'none';
}
const { active } = Astro.props;
const WEB_APP = 'https://app.heybefree.app';
// Universal-purchase App Store record (same id as StoreBadge.astro).
const APP_STORE = 'https://apps.apple.com/app/id6763826891';
// The persistent nav CTA is the smart "Get BeFree" button — the Site layout
// script rewrites its href to the visitor's platform door (App Store / Mac
// App Store / Android tester flow), with the web app as the no-JS default.
// On /pricing it scrolls to the plans instead.
const smartCta = active !== 'pricing';
const ctaHref = smartCta ? WEB_APP : '#tiers';
const ctaLabel = smartCta ? 'Get BeFree' : 'Get started';
---

<div class="navbar">
  <div class="inner">
    <a href="/" class="logo">
      <img src="/assets/icon.png" alt="BeFree" width="34" height="34" />
      <span>BeFree</span>
    </a>
    <div class="links bf-navlinks">
      <a href={APP_STORE} class="link plat">
        <i class="ph-bold ph-apple-logo"></i> iOS
      </a>
      <a href="/mac" class:list={['link', 'plat', { active: active === 'mac' }]}>
        <i class={active === 'mac' ? 'ph-fill ph-desktop' : 'ph-bold ph-desktop'}></i> Mac
      </a>
      <a href="/android" class:list={['link', 'plat', { active: active === 'android' }]}>
        <i class={active === 'android' ? 'ph-fill ph-android-logo' : 'ph-bold ph-android-logo'}></i> Android
      </a>
      <a href={WEB_APP} class="link plat">
        <i class="ph-bold ph-globe"></i> Web
      </a>
      <a href="/pricing" class:list={['link', { active: active === 'pricing' }]}>Pricing</a>
      <a href={ctaHref} class="cta" data-get-befree={smartCta ? '' : undefined}>{ctaLabel}</a>
    </div>
  </div>
</div>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    /* backdrop-filter re-blurs the scrolling content behind the nav every
       frame — a real scroll cost. Keep a lighter frost (smaller radius) and a
       more opaque base so less needs blurring. */
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 13px clamp(18px, 4vw, 40px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }
  .logo img {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    box-shadow: var(--elev-1);
    display: block;
  }
  .logo span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.3px;
    color: var(--text);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .link {
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .link:hover {
    color: var(--text);
  }
  .link.plat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .link.plat i {
    font-size: 15px;
  }
  /* AFTER the base rules — equal specificity, so source order is what lets
     these win inside the queries. Five words + a CTA is wider than the old
     three-link nav, so the squeeze starts at tablet width, not phone width. */
  @media (max-width: 920px) {
    .links {
      gap: 15px;
    }
    /* The glyphs go, the words stay — the words are the wayfinding. */
    .link.plat i {
      display: none;
    }
  }
  @media (max-width: 680px) {
    .links {
      gap: 11px;
    }
    .link {
      font-size: 13.5px;
    }
    .cta {
      font-size: 13.5px;
      padding: 8px 13px;
    }
  }
  /* Phone: the four platform doors are the point of this nav (owner,
     2026-08-21) — so they keep their words and everything else gives way in
     stages: first the wordmark (the icon stays), then on the narrowest
     phones the Pricing text link (Pricing stays one scroll or one footer
     away). */
  @media (max-width: 560px) {
    .inner {
      gap: 12px;
    }
    .logo span {
      display: none;
    }
    .links {
      gap: 10px;
    }
  }
  @media (max-width: 430px) {
    .link:not(.plat) {
      display: none;
    }
    .link {
      font-size: 13px;
    }
    .links {
      gap: 9px;
    }
    .cta {
      font-size: 13px;
      padding: 7px 11px;
    }
  }
  .link.active {
    font-weight: 600;
    color: var(--accent);
  }
  .cta {
    text-decoration: none;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.2px;
    padding: 10px 18px;
    border-radius: var(--radius-input);
    box-shadow: var(--elev-1);
    white-space: nowrap;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }
  .cta:hover {
    transform: translateY(-1px);
    box-shadow: var(--elev-2);
  }
</style>
